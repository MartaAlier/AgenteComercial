generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// AGENTES
// ============================================================
model Agent {
  id          String   @id @default(uuid())
  name        String   @unique
  role        String   @unique
  description String
  avatar      String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs        ActivityLog[]
  leadActions LeadAction[]
}

// ============================================================
// EMPRESAS / LEADS
// ============================================================
model Lead {
  id              String   @id @default(uuid())
  companyName     String
  companyType     String?  // pequeño_distribuidor | gran_mayorista | gran_constructora | otro
  address         String?
  googleMapsUrl   String?
  description     String?  // descripción de la empresa
  website         String?
  phones          String?  // JSON array de teléfonos
  emails          String?  // JSON array de emails
  keyContacts     String?  // JSON array [{name, position, linkedin, phone, email}]
  region          String?
  city            String?
  country         String?
  source          String?  // qué agente lo encontró
  status          String   @default("pending") // pending | enriched | complete | no_data
  score           Int      @default(0)
  verified        Boolean  @default(false) // true si los datos fueron verificados
  confidence      String   @default("low") // low | medium | high
  notes           String?
  batch           Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  actions         LeadAction[]

  @@unique([companyName, city, country])
  @@index([batch])
  @@index([status])
  @@index([city, country])
  @@index([companyType])
}

// ============================================================
// ACCIONES SOBRE LEADS
// ============================================================
model LeadAction {
  id        String   @id @default(uuid())
  leadId    String
  agentId   String
  type      String
  summary   String
  details   String?
  createdAt DateTime @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

// ============================================================
// LOG DE ACTIVIDAD
// ============================================================
model ActivityLog {
  id        String   @id @default(uuid())
  agentId   String
  category  String
  action    String
  details   String?
  metadata  String?
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}
